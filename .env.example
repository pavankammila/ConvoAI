# ==========================================================
# ConvoAI Environment Configuration
# Copy to .env for local development. Never commit .env to Git.
# ==========================================================

# Runtime environment: "development" | "production"
NODE_ENV=development

# Required: Google Gemini API key (keep secret on server only)
GEMINI_API_KEY=

# Optional: Default Gemini model (e.g. gemini-4-hydrogen or gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-4-hydrogen

# Server network settings
HOST=0.0.0.0
PORT=3000

# SQLite database path
# Development: ./convoai.db
# Cloud production: mount a persistent volume (e.g. /data/convoai.db)
DATABASE_PATH=./convoai.db

# Conversation context window settings
MAX_HISTORY=12
KEEP_RECENT=6
REQUEST_TIMEOUT=30

# Rate limit per client IP per minute on AI chat/extract routes
RATE_LIMIT_PER_MINUTE=30

# Reverse proxy IP trust ("false" locally, "1" or "true" behind Cloud Run / Nginx / LB)
TRUST_PROXY=false

# Comma-separated allowed CORS origins (leave empty for same-origin only)
# Production requires explicit https:// origins; wildcard "*" is ignored in production.
CORS_ORIGINS=